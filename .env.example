BASE_URL=http://localhost:8000
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
# odd and not a multiple of 31; generate with:
# python -c "import secrets;print(next(n for n in iter(lambda: secrets.randbelow(62**7),None) if n%2 and n%31))"
# Never change after launch.
CODE_MULTIPLIER=
# openssl rand -hex 32
IP_HASH_SALT=
SAFE_BROWSING_API_KEY=
RATE_LIMIT_PER_MIN=60
LINK_CACHE_TTL=3600
# Proxy IPs trusted for X-Forwarded-For. "*" only if the app port is not publicly reachable.
FORWARDED_ALLOW_IPS=127.0.0.1
